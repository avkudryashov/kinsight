<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Spec §2: the cloud is an option of this app, off by default; it reaches only the user's own Yandex Disk. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Do NOT declare android:process on any component: select() takes an in-process lock plus a cross-process
         file lock, but the key stores (Keystore and the software file) are designed and tested for a single
         process only. -->
    <!-- Predictive back and the per-app language list are API 33+; older phones ignore them (tools:targetApi). -->
    <application
        android:name=".KinsightApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kinsight"
        tools:targetApi="33">

        <!-- Google Play monitoring flag (research §1.4), in every variant. Only the meta-data form: the platform
             android-36 has no android:isMonitoringTool attribute (checked 2026-10-10); add it with compileSdk 37. -->
        <meta-data
            android:name="isMonitoringTool"
            android:value="child_monitoring" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invitations (spec §6.4): the QR content opens the app from the system camera as well. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kinsight" android:host="pair" />
            </intent-filter>
            <!-- Yandex sign-in (spec §3, §14): the Android platform's yx<client_id> redirect, once it is registered. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${yandexScheme}" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false" />
    </application>
</manifest>
