<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE only (spec §2): the app has no other transport. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- neverForLocation: scanning never derives location, so no location permission (spec §2; minSdk 31, so no targetApi guard). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application>
        <!-- Background scan results arrive here through a PendingIntent (works in deep Doze, spike 2026-10-09). -->
        <receiver
            android:name=".ScanReceiver"
            android:exported="false" />
    </application>
</manifest>
