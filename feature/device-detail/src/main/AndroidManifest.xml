<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- «Open on map» on the location screen (rulings L1): shown only when some app opens a geo: link. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- «Яндекс Карты» and «Google Карты» (offline map spec §5): each button only when its app is installed. -->
        <package android:name="ru.yandex.yandexmaps" />
        <package android:name="com.google.android.apps.maps" />
    </queries>
</manifest>
